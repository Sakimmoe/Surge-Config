# ==================== 一键体检 ====================
health_check() {
  clear
  hr
  print_info "Snell 一键体检"
  hr
  echo "=== Snell 服务 ==="
  systemctl is-enabled snell --no-pager 2>/dev/null || true
  systemctl is-active snell --no-pager 2>/dev/null || true
  echo "=== 监听端口 ==="
  ss -tlnp | grep snell || echo "未发现 snell 监听端口"
  echo "=== BBR ==="
  sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc 2>/dev/null || true
  echo "=== TCP/网络优化 ==="
  sysctl net.ipv4.tcp_fastopen net.ipv4.tcp_rmem net.ipv4.tcp_wmem net.core.rmem_max net.core.wmem_max vm.swappiness 2>/dev/null || true
  echo "=== Swap ==="
  free -h
  systemctl is-enabled disable-swap --no-pager 2>/dev/null || true
  echo "=== DNS ==="
  cat /etc/resolv.conf
  systemctl is-enabled systemd-resolved --no-pager 2>/dev/null || true
  echo "=== UFW ==="
  ufw status | head -10
  echo "=== 时区 ==="
  timedatectl show -p Timezone --value 2>/dev/null || true
  echo "=== 快捷命令 ==="
  ls -l /usr/local/bin/s 2>/dev/null || true
  hr
  pause
}

# ==================== 卸载 ====================
uninstall_snell() {
  clear
  hr
  if ! is_installed; then
    print_err "Snell 未安装"
    pause
    return
  fi

  local ans
  read -rp "确认卸载并删除所有配置？(y/N): " ans
  [[ ! "${ans:-N}" =~ ^[Yy]$ ]] && { print_info "已取消"; pause; return; }

  print_info "停止服务..."
  systemctl stop snell >/dev/null 2>&1 || true
  systemctl disable snell >/dev/null 2>&1 || true
  rm -f "$SNELL_SERVICE_FILE"
  systemctl daemon-reload >/dev/null 2>&1 || true

  print_info "清理文件..."
  rm -f /usr/local/bin/snell-server /usr/local/bin/snell-server.bak
  rm -f /usr/local/bin/snell
  rm -f /usr/local/bin/a
  rm -f /usr/local/bin/s
  rm -f /usr/local/bin/snell-panel.sh
  rm -f "${CONFIG_DIR}/snell-panel.sh"
  rm -f "$CRON_CLEAN"
  rm -f /usr/local/bin/snell-cleanup.sh
  rm -rf "$CONFIG_DIR"

  print_ok "Snell 已彻底卸载"
  pause
}

