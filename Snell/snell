# ==================== 更改端口 ====================
change_port() {
  clear
  hr
  print_info "更改 Snell 端口"
  hr

  if ! is_installed; then
    print_err "Snell 未安装"
    pause
    return
  fi

  local CUR_PORT=$(get_conf_port)
  [[ -z "$CUR_PORT" ]] && CUR_PORT="26216"
  local NEW_PORT=$(read_port_interactive "" "$CUR_PORT")

  [[ "$NEW_PORT" = "$CUR_PORT" ]] && { print_ok "端口未变更"; pause; return; }

  local CUR_STACK=$(cat "$STACK_FILE" 2>/dev/null || echo "dual")
  local NEW_LISTEN
  NEW_LISTEN=$(make_listen "$CUR_STACK" "$NEW_PORT")
  sed -i "s|^listen[[:space:]]*=.*|listen = ${NEW_LISTEN}|" "$CONF_FILE"
  judge "配置更新"

  setup_ufw "$NEW_PORT"

  systemctl restart snell >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "端口已更新为: ${NEW_PORT}"
    local PASS=$(get_conf_psk)
    local MODE=$(cat "$MODE_FILE" 2>/dev/null || echo "default")
    export_snell_info "$NEW_PORT" "$PASS" "$MODE"
  else
    print_err "服务重启失败"
  fi
  pause
}

