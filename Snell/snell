#!/usr/bin/env bash
# Snell (snell-server) 一键管理脚本：安装、查看、更改端口/密码、切换监听模式、体检、卸载
# 基于官方 snell-server v6 闭源二进制，无证书/TLS 依赖
# 搭建方法参考: getsomecat/GetSomeCats 简单搭建Snell服务.md
# 整体优化与搭建方式套用: Sakimmoe/AnyTLS anytls 脚本
# 兼容 Debian 11/12/13、Ubuntu、CentOS，支持 amd64 / i386 / aarch64
#
# 重启后保持生效（重要）：
#   Debian 13 (trixie) 起 systemd 只读 /usr/lib/sysctl.d、/etc/sysctl.d、/run/sysctl.d，
#   不再读取 /etc/sysctl.conf（compat 软链 99-sysctl.conf 已被移除），
#   因此内核参数必须写进 /etc/sysctl.d/*.conf，否则重启后 BBR 会失效。
#   本脚本统一写入 /etc/sysctl.d/99-snell-network.conf，并由开机自愈服务
#   snell-net-tune.service / snell-dns.service 在启动末期重新强制生效，
#   防止 DHCP 客户端、cloud-init、VPS 面板等把设置改回去。

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

# ==================== 配置路径 ====================
CONFIG_DIR="/etc/snell"
WORK_DIR="$CONFIG_DIR"
SNELL_SERVICE_NAME="snell.service"
SNELL_SERVICE_FILE="/etc/systemd/system/${SNELL_SERVICE_NAME}"
CONF_FILE="${CONFIG_DIR}/snell-server.conf"
LIST_FILE="${CONFIG_DIR}/list"
CRON_CLEAN="/etc/cron.d/snell-cleanup"
STACK_FILE="${CONFIG_DIR}/.stack"
NET_FILE="${CONFIG_DIR}/.netstack"
MODE_FILE="${CONFIG_DIR}/.mode"
NET_NOFILE_LIMIT=1048576
SNELL_BIN="/usr/local/bin/snell-server"
SNELL_VERSION="v6.0.0rc2"
SHELL_VERSION="0.1.1"

# ==================== 重启后依然生效的系统配置 ====================
# 内核参数：只写 /etc/sysctl.d/，不再碰 /etc/sysctl.conf（Debian 13 已不读该文件）
SYSCTL_FILE="/etc/sysctl.d/99-snell-network.conf"
LEGACY_SYSCTL_FILE="/etc/sysctl.d/99-bbr.conf"
SYSCTL_MIGRATED_FLAG="${CONFIG_DIR}/.sysctl-migrated"
# 开机自愈：内核参数 + 时区
NET_TUNE_UNIT_NAME="snell-net-tune.service"
NET_TUNE_UNIT_FILE="/etc/systemd/system/${NET_TUNE_UNIT_NAME}"
NET_TUNE_SCRIPT="/usr/local/bin/snell-net-tune.sh"
# 开机自愈：静态 DNS
DNS_UNIT_NAME="snell-dns.service"
DNS_UNIT_FILE="/etc/systemd/system/${DNS_UNIT_NAME}"
DNS_SCRIPT="/usr/local/bin/snell-dns.sh"
REQUIRED_NS_V4="1.1.1.1 8.8.8.8"
REQUIRED_NS_V6="2606:4700:4700::1111 2001:4860:4860::8888"
TZ_NAME="Asia/Shanghai"
# 可选：在线一键安装时，从这里下载面板脚本保存到本地
SCRIPT_URL="https://raw.githubusercontent.com/Sakimmoe/Surge-Config/main/Snell/snell"

# ==================== 颜色配置 ====================
Font="\033[0m"
Black="\033[30m"
Red="\033[31m"
Green="\033[32m"
Yellow="\033[33m"
Blue="\033[34m"
Magenta="\033[35m"
Cyan="\033[36m"
White="\033[37m"
BRed="\033[91m"
BGreen="\033[92m"
BYellow="\033[93m"
BCyan="\033[96m"
Bold="\033[1m"

OK="${Green}[OK]${Font}"
ERROR="${Red}[ERROR]${Font}"
WARN="${Yellow}[WARN]${Font}"
INFO="${Cyan}[INFO]${Font}"

print_ok()  { echo -e "${OK}${Blue} $1 ${Font}"; }
print_info(){ echo -e "${INFO}${Cyan} $1 ${Font}"; }
print_warn(){ echo -e "${WARN}${Yellow} $1 ${Font}" >&2; }
print_err() { echo -e "${ERROR} ${BRed}$1${Font}" >&2; }

judge() {
  if [[ $? -eq 0 ]]; then
    print_ok "$1 完成"
    sleep 0.5
  else
    print_err "$1 失败"
    exit 1
  fi
}

hr() { printf '%*s\n' 50 '' | tr ' ' '='; }

pause() { read -rp "按回车返回菜单..." _; }

ensure_root() {
  if [[ $EUID -ne 0 ]]; then
    clear
    print_err "必须使用 root 运行本脚本!"
    exit 1
  fi
}

# 安装过程中随时失败退出时，兜底把系统关键设置再重申一次（幂等，可重复执行）
IN_INSTALL=false
install_guard_exit() {
  local rc=$?
  # 只在“父 shell 的安装流程”里兜底：
  # 子 shell 正常收尾时不要重复执行（BASHPID 与父 shell 的 $$ 不同）
  [[ "$IN_INSTALL" == true ]] || return 0
  [[ "$BASHPID" == "$$" ]] || return 0
  enforce_critical_settings >/dev/null 2>&1 || true
  return "$rc"
}

# ==================== 状态检测 ====================
binary_exists() { [[ -x "$SNELL_BIN" ]]; }
service_exists() { [[ -f "$SNELL_SERVICE_FILE" ]]; }
is_installed()   { binary_exists || service_exists; }
is_active()      { systemctl is-active "$SNELL_SERVICE_NAME" >/dev/null 2>&1; }

get_local_version() {
  if binary_exists; then
    local raw v
    raw=$("$SNELL_BIN" -v 2>&1 || "$SNELL_BIN" --version 2>&1 || "$SNELL_BIN" -version 2>&1 || "$SNELL_BIN" -V 2>&1 || true)
    v=$(printf '%s\n' "$raw" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+(rc[0-9]+)?' | head -1 || true)
    echo "${v:-unknown}"
  else
    echo "未安装"
  fi
}

install_status_text() {
  local stack_info=""
  local mode_info=""
  if [[ -f "$STACK_FILE" ]]; then
    local stack=$(cat "$STACK_FILE" 2>/dev/null || echo "")
    case "$stack" in
      dual)   stack_info=" | ${Cyan}双栈(v6入+仅v4出)${Font}" ;;
      v4only) stack_info=" | ${Cyan}仅IPv4${Font}" ;;
      v6only) stack_info=" | ${Cyan}仅IPv6入站${Font}" ;;
    esac
  fi
  if [[ -f "$MODE_FILE" ]]; then
    local mode=$(cat "$MODE_FILE" 2>/dev/null || echo "")
    [[ -n "$mode" ]] && mode_info=" | ${Cyan}模式:${mode}${Font}"
  fi

  if is_installed; then
    if is_active; then
      echo -e "${BGreen}已安装（运行中）${Font}${stack_info}${mode_info}"
    else
      if systemctl is-failed "$SNELL_SERVICE_NAME" >/dev/null 2>&1; then
        echo -e "${BYellow}已安装（上次启动失败）${Font}${stack_info}${mode_info}"
      else
        echo -e "${BYellow}已安装（已停止）${Font}${stack_info}${mode_info}"
      fi
    fi
  else
    echo -e "${BRed}未安装${Font}"
  fi
}

# ==================== 工具函数 ====================
random_port() { shuf -i 2000-65000 -n 1; }
gen_password(){ cat /proc/sys/kernel/random/uuid; }

valid_port() {
  local p="${1:-}"
  [[ "$p" =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 ))
}

is_port_used() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -tuln | awk '{print $5}' | grep -Eq "[:.]${port}([[:space:]]|$)"
  elif command -v lsof >/dev/null 2>&1; then
    lsof -i :"$port" -sTCP:LISTEN >/dev/null 2>&1
  else
    return 1
  fi
}

read_port_interactive() {
  local input current="${2:-}"
  while true; do
    if [[ -n "$current" ]]; then
      read -rp "回车保持当前端口 [${current}]，或输入新端口(1-65535): " input
      [[ -z "$input" ]] && { echo "$current"; return; }
    else
      read -t 15 -rp "回车或等待15秒为随机端口，或输入端口(1-65535): " input || true
      [[ -z "$input" ]] && input=$(random_port)
    fi

    if ! valid_port "$input"; then
      print_warn "端口不合法：$input"
      continue
    fi
    if is_port_used "$input"; then
      print_warn "端口 $input 已被占用"
      continue
    fi
    echo "$input"
    break
  done
}

valid_psk() {
  local p="${1:-}"
  [[ -n "$p" && ${#p} -ge 12 && ${#p} -le 255 && "$p" =~ ^[A-Za-z0-9._+=\/-]+$ ]]
}

read_psk_interactive() {
  local current="${1:-}" default="${2:-}" input pass
  while true; do
    if [[ -n "$current" ]]; then
      read -rp "请输入新密码（回车保持原密码）[当前: ${current}]: " input
      [[ -z "$input" ]] && { echo "$current"; return; }
      pass="$input"
    else
      read -rp "请输入 Snell 密码（回车使用随机密码）[默认: ${default}]: " input
      pass=${input:-$default}
    fi
    if ! valid_psk "$pass"; then
      print_warn "密码需 12-255 位，且仅允许字母/数字和 . _ + = / -"
      continue
    fi
    echo "$pass"
    break
  done
}

read_mode_interactive() {
  local input mode
  # 该函数在 $( ) 中调用，菜单必须输出到 stderr 才会显示
  echo "" >&2
  echo "请选择 Snell v6 协议模式（服务端与客户端必须一致）：" >&2
  echo " 1. default     混淆 + AES 加密（推荐，流量特征随 PSK 变化）" >&2
  echo " 2. unshaped    仅 AES 加密，无混淆，吞吐约快 10%（特征类似随机流）" >&2
  echo " 3. unsafe-raw  明文传输，无加密无混淆（仅限内网或已有安全隧道）" >&2
  while true; do
    read -rp "请选择协议模式 [1=default / 2=unshaped / 3=unsafe-raw，回车默认 1]: " input
    case "${input:-1}" in
      1) mode="default"; break ;;
      2) mode="unshaped"; break ;;
      3)
        mode="unsafe-raw"
        print_warn "unsafe-raw 为明文模式，仅适合内网或已有安全隧道，请谨慎选择"
        break
        ;;
      *) print_warn "无效选项，请输入 1-3" ;;
    esac
  done
  echo "$mode"
}

check_system_ip() {
  local IP_CACHE="${CONFIG_DIR}/.ips"
  local new4 new6
  new4=$(curl -4 -s --max-time 5 https://api.ipify.org 2>/dev/null || echo "")
  new6=$(curl -6 -s --connect-timeout 3 https://api64.ipify.org 2>/dev/null || echo "")

  # 探测失败时回退到上次成功保存的 IP，避免节点行输出占位符
  if [[ -z "$new4" && -f "$IP_CACHE" ]]; then
    new4=$(sed -n '1p' "$IP_CACHE" 2>/dev/null || true)
  fi
  if [[ -z "$new6" && -f "$IP_CACHE" ]]; then
    new6=$(sed -n '2p' "$IP_CACHE" 2>/dev/null || true)
  fi

  IPV4=$new4
  IPV6=$new6
  MAIN_IP=$([ -n "$IPV4" ] && echo "$IPV4" || echo "$IPV6")

  if [[ -n "$IPV4" && -n "$IPV6" ]]; then
    IP_STACK="dual"
  elif [[ -n "$IPV4" ]]; then
    IP_STACK="v4only"
  elif [[ -n "$IPV6" ]]; then
    IP_STACK="v6only"
  else
    IP_STACK="unknown"
  fi

  # 探测成功则更新缓存，供下次失败时回退
  if [[ -n "$IPV4" || -n "$IPV6" ]]; then
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    printf '%s\n%s\n' "$IPV4" "$IPV6" > "$IP_CACHE" 2>/dev/null || true
  fi
}

get_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo "amd64" ;;
    i386|i486|i586|i686|x86) echo "i386" ;;
    aarch64|arm64) echo "aarch64" ;;
    *) print_err "不支持的架构: $(uname -m)"; exit 1 ;;
  esac
}

# ==================== 系统依赖自动安装 ====================
# 自动安装 curl/unzip 等依赖；首次失败后刷新软件源并显示真实错误重试，
# 避免“静默安装失败 -> 只报缺少 unzip -> 直接退出”的问题
pm_install() {
  local pm="$1"; shift
  case "$pm" in
    apt) apt-get install -y -qq "$@" ;;
    dnf) dnf install -y -q "$@" ;;
    yum) yum install -y -q "$@" ;;
  esac
}

pm_refresh() {
  local pm="$1"
  case "$pm" in
    apt) apt-get update -qq ;;
    dnf) dnf makecache -y ;;
    yum) yum makecache ;;
  esac
}

install_deps() {
  local pm="" cmd="" missing=0 pkgs=""

  for cmd in curl unzip; do
    command -v "$cmd" >/dev/null 2>&1 || missing=1
  done

  if command -v apt-get >/dev/null 2>&1; then
    pm="apt"
  elif command -v dnf >/dev/null 2>&1; then
    pm="dnf"
  elif command -v yum >/dev/null 2>&1; then
    pm="yum"
  fi

  # 系统没有 apt/dnf/yum 时：依赖齐全则放行，否则给出手动安装指引
  if [[ -z "$pm" ]]; then
    if [[ $missing -eq 1 ]]; then
      print_err "未检测到 apt-get/dnf/yum，无法自动安装 curl/unzip"
      print_err "请先手动安装这两个依赖后再运行本脚本"
      exit 1
    fi
    return 0
  fi

  # 必需依赖一组安装；ufw 是可选组件，单独尝试，不参与必需检查
  # systemd-timesyncd 一并装上：Debian 13 的精简 cloud 镜像默认不带时间同步守护进程，
  # 不装的话 timedatectl 会显示 "NTP service: n/a / System clock synchronized: no"
  case "$pm" in
    apt)        pkgs="curl unzip ca-certificates iproute2 cron systemd-timesyncd" ;;
    dnf|yum)    pkgs="curl unzip ca-certificates cronie chrony" ;;
  esac

  print_info "使用 ${pm} 安装依赖: ${pkgs}"
  # shellcheck disable=SC2086
  if ! pm_install "$pm" $pkgs; then
    print_warn "依赖首次安装未成功，正在刷新软件源并带详细输出重试..."
    sleep 3
    pm_refresh "$pm" || true
    case "$pm" in
      apt)     apt-get install -y $pkgs || true ;;
      dnf)     dnf install -y $pkgs || true ;;
      yum)     yum install -y $pkgs || true ;;
    esac
  fi

  if [[ "$pm" == "apt" ]] && ! command -v ufw >/dev/null 2>&1; then
    apt-get install -y -qq ufw >/dev/null 2>&1 || true
  fi

  for cmd in curl unzip; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      print_err "必要依赖 ${cmd} 安装失败，请检查上方软件源/网络错误后手动安装再重试"
      print_err "Debian/Ubuntu: apt-get update && apt-get install -y ${cmd}"
      print_err "CentOS/RHEL:   yum install -y ${cmd}   (或 dnf install -y ${cmd})"
      exit 1
    fi
  done
}

get_service_group() {
  local g
  g=$(sed -n 's/^Group=//p' "$SNELL_SERVICE_FILE" 2>/dev/null | head -1)
  echo "${g:-nogroup}"
}

# ==================== 配置文件读写 ====================
get_conf_port() {
  sed -n 's/^listen[[:space:]]*=.*:\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$CONF_FILE" 2>/dev/null | head -1 || true
}

get_conf_psk() {
  sed -n 's/^psk[[:space:]]*=//p' "$CONF_FILE" 2>/dev/null | tr -d ' \r' | head -1 || true
}

# 生成 v6 的多地址 listen / dns / dns-ip-preference
make_listen() {
  local STACK="$1" PORT="$2"
  case "$STACK" in
    v4only) echo "0.0.0.0:${PORT}" ;;
    v6only) echo "[::]:${PORT}" ;;
    *)      echo "0.0.0.0:${PORT},[::]:${PORT}" ;;
  esac
}

# 服务器真实网络：安装时探测一次写入 .netstack（v4only / dual / v6only）
get_egress_stack() {
  local ns
  ns=$(cat "$NET_FILE" 2>/dev/null || echo "")
  case "$ns" in
    v4only|dual|v6only) echo "$ns" ;;
    *) echo "unknown" ;;
  esac
}

make_dns() {
  # 出站 DNS 按真实网络：有 IPv4 就用 IPv4 DNS；纯 IPv6 服务器用 IPv6 DNS
  case "$(get_egress_stack)" in
    v6only) echo "2606:4700:4700::1111,2001:4860:4860::8888" ;;
    *)      echo "1.1.1.1,8.8.8.8" ;;
  esac
}

make_dns_pref() {
  # 出站地址族按真实网络：
  # - 有 IPv4（仅 v4 / 双栈）：只用 IPv4 出站，IPv6 仍可入站
  # - 纯 IPv6：只能 IPv6 出站，否则无法联网
  case "$(get_egress_stack)" in
    v6only) echo "ipv6-only" ;;
    *)      echo "ipv4-only" ;;
  esac
}

write_snell_conf() {
  local PORT="$1" PASS="$2" STACK="$3" MODE="$4"
  local LISTEN DNS_STR DNS_PREF
  LISTEN=$(make_listen "$STACK" "$PORT")
  DNS_STR=$(make_dns "$STACK")
  DNS_PREF=$(make_dns_pref "$STACK")
  cat > "$CONF_FILE" <<EOF
[snell-server]
listen = ${LISTEN}
psk = ${PASS}
mode = ${MODE}
dns = ${DNS_STR}
dns-ip-preference = ${DNS_PREF}
EOF
  local GRP
  GRP=$(get_service_group)
  chown "root:${GRP}" "$CONF_FILE" >/dev/null 2>&1 || chmod 644 "$CONF_FILE"
  chmod 640 "$CONF_FILE" >/dev/null 2>&1 || true
}

# ==================== 下载 snell-server ====================
download_snell() {
  local DEST_BIN="${1:-$SNELL_BIN}"
  local TMP_DL TMP_BIN URL MIRROR FILE
  TMP_DL=$(mktemp -d /tmp/snell-dl.XXXXXX)
  URL="https://dl.nssurge.com/snell/snell-server-${SNELL_VERSION}-linux-${ARCH}.zip"
  MIRROR="https://raw.githubusercontent.com/Sakimmoe/Surge-Config/main/vendor/snell-server-${SNELL_VERSION}-linux-${ARCH}.zip"
  TMP_BIN="${DEST_BIN}.tmp.$$"

  # 三个源依次尝试，前面失败不会影响后面（旧写法用 && / || 串联，语义容易出错）
  if curl -fsSL --connect-timeout 15 -o "${TMP_DL}/snell-server.pkg" "$URL" 2>/dev/null; then
    :
  elif curl -fsSL --connect-timeout 15 -o "${TMP_DL}/snell-server.pkg" "$MIRROR" 2>/dev/null; then
    print_warn "官方源 (dl.nssurge.com) 下载失败（无 IPv6 或网络问题），已改用 GitHub 备用源"
  elif wget -q --timeout=30 -O "${TMP_DL}/snell-server.pkg" "$MIRROR" 2>/dev/null; then
    print_warn "curl 下载失败，已改用 wget 从 GitHub 备用源下载"
  else
    print_err "官方源与 GitHub 备用源都下载失败，请检查服务器网络或 DNS"
    rm -rf "$TMP_DL"
    return 1
  fi

  if [[ ! -s "${TMP_DL}/snell-server.pkg" ]]; then
    rm -rf "$TMP_DL"
    return 1
  fi

  if ! unzip -q -o "${TMP_DL}/snell-server.pkg" -d "${TMP_DL}" 2>/dev/null; then
    print_err "安装包解压失败（下载到的可能不是 zip，请检查网络是否被劫持）"
    rm -rf "$TMP_DL"
    return 1
  fi

  FILE=$(find "${TMP_DL}" -type f -name "snell-server" | head -1 || true)
  if [[ -z "$FILE" ]]; then
    print_err "安装包内未找到 snell-server 可执行文件"
    rm -rf "$TMP_DL"
    return 1
  fi

  # 覆盖前留一份可执行备份，新版本起不来时能回滚
  if [[ -x "$DEST_BIN" ]]; then
    if ! cp -pf "$DEST_BIN" "${DEST_BIN}.bak" 2>/dev/null; then
      print_warn "旧二进制备份失败，继续安装新版本"
    fi
  fi

  if ! cp -f "$FILE" "$TMP_BIN" || ! chmod +x "$TMP_BIN" || ! mv -f "$TMP_BIN" "$DEST_BIN"; then
    print_err "安装 snell-server 到 ${DEST_BIN} 失败"
    rm -rf "$TMP_DL" "$TMP_BIN"
    return 1
  fi
  rm -rf "$TMP_DL"
  echo "${SNELL_VERSION#v}"
}

# ==================== 防火墙配置 ====================
setup_ufw() {
  local PORT="$1"
  if ! command -v ufw >/dev/null 2>&1; then
    print_warn "未安装 UFW，跳过防火墙配置；请手动放行端口 ${PORT}/tcp"
    return 0
  fi
  print_info "配置防火墙 (UFW)..."
  systemctl unmask ufw >/dev/null 2>&1 || true
  systemctl enable --now ufw >/dev/null 2>&1 || true
  if [[ -f /etc/default/ufw ]]; then
    sed -i 's/IPV6=no/IPV6=yes/' /etc/default/ufw 2>/dev/null || true
  fi
  ufw --force reset >/dev/null 2>&1 || true
  ufw default deny incoming >/dev/null 2>&1 || true
  ufw default allow outgoing >/dev/null 2>&1 || true

  local SSH_PORT=22
  if [[ -f /etc/ssh/sshd_config ]]; then
    SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config | head -1 | awk '{print $2}' | tr -d '\r\n' || true)
  fi
  if [[ -z "$SSH_PORT" ]] && [[ -d /etc/ssh/sshd_config.d ]]; then
    SSH_PORT=$(grep -Ei '^\s*Port\s+' /etc/ssh/sshd_config.d/*.conf 2>/dev/null | head -1 | awk '{print $2}' | tr -d '\r\n' || true)
  fi
  [[ "$SSH_PORT" =~ ^[0-9]+$ ]] || SSH_PORT=22

  ufw allow "${SSH_PORT}/tcp" comment 'SSH' >/dev/null 2>&1 || true
  ufw allow "${PORT}/tcp" comment 'Snell TCP' >/dev/null 2>&1 || true
  ufw --force enable >/dev/null 2>&1 || true
  ufw reload >/dev/null 2>&1 || true
  if ufw status 2>/dev/null | grep -q "Status: active"; then
    print_ok "UFW 防火墙配置 完成"
  else
    print_warn "UFW 未能确认启用，请手动检查: ufw status"
  fi
}

# ==================== 定时任务 ====================
setup_cron() {
  local CLEAN_SCRIPT="/usr/local/bin/snell-cleanup.sh"

  cat > "$CLEAN_SCRIPT" <<'EOF'
#!/bin/bash

set -e

# apt 缓存与残留依赖
apt-get clean >/dev/null 2>&1 || true
apt-get autoclean -y >/dev/null 2>&1 || true
apt-get autoremove --purge -y >/dev/null 2>&1 || true
# apt 索引缓存（pkgcache.bin），apt 会自动重建，删除安全
rm -f /var/cache/apt/pkgcache.bin /var/cache/apt/srcpkgcache.bin >/dev/null 2>&1 || true

# systemd 日志（含 Snell）：保留最近 3 天且总大小不超过 30M
journalctl --vacuum-time=3d --vacuum-size=30M >/dev/null 2>&1 || true

# 临时文件：只删 7 天以上的普通文件，再删 7 天以上的空目录
find /tmp /var/tmp -mindepth 1 -type f -mtime +7 -delete >/dev/null 2>&1 || true
find /tmp /var/tmp -mindepth 1 -type d -mtime +7 -empty -delete >/dev/null 2>&1 || true

# 下载残留与更新残留
# 注意：不要删除 snell-server.bak —— 它是二进制替换失败时的回滚文件
find /usr/local/bin -maxdepth 1 -name 'snell-server.tmp.*' -mtime +1 -delete >/dev/null 2>&1 || true
find /etc/snell -maxdepth 1 -name '*.tmp' -mtime +1 -delete >/dev/null 2>&1 || true
find /etc/snell -maxdepth 1 -name '*.v5bak' -mtime +7 -delete >/dev/null 2>&1 || true
rm -rf /tmp/snell-dl.* /tmp/snell.zip >/dev/null 2>&1 || true

# 清理 systemd 失败状态
systemctl reset-failed >/dev/null 2>&1 || true

exit 0
EOF

  chmod +x "$CLEAN_SCRIPT"

  cat > "$CRON_CLEAN" <<EOF
7 7 * * 0 root $CLEAN_SCRIPT >/dev/null 2>&1
EOF

  chmod 644 "$CRON_CLEAN"

  judge "定时任务配置"
}

# ==================== 导出节点信息 ====================
export_snell_info() {
  local PORT="$1" PASS="$2" MODE="$3"
  MODE=${MODE:-$(cat "$MODE_FILE" 2>/dev/null || echo "default")}
  check_system_ip

  # 输出 Surge 节点行：IPv4 和 IPv6 都输出（服务器有哪种就输出哪种）
  local EXTRA="version=6, reuse=true, ecn=true, tfo=true"
  [[ "$MODE" != "default" ]] && EXTRA="version=6, mode=${MODE}, reuse=true, ecn=true, tfo=true"

  local LINE4="" LINE6=""
  if [[ -n "$IPV4" ]]; then
    LINE4="IPv4 = snell, ${IPV4}, ${PORT}, psk=${PASS}, ${EXTRA}"
  fi
  if [[ -n "$IPV6" ]]; then
    # Surge 的 Snell 节点行 IPv6 地址不加方括号，实测加括号会不通
    LINE6="IPv6 = snell, ${IPV6}, ${PORT}, psk=${PASS}, ${EXTRA}"
  fi
  if [[ -z "$LINE4" && -z "$LINE6" ]]; then
    LINE4="IPv4 = snell, 服务器IP, ${PORT}, psk=${PASS}, ${EXTRA}"
  fi

  {
    [[ -n "$LINE4" ]] && printf '%s\n' "$LINE4"
    [[ -n "$LINE6" ]] && printf '%s\n' "$LINE6"
  } > "$LIST_FILE"
  chmod 600 "$LIST_FILE"
}

# ==================== 快捷命令配置 ====================
create_shortcut() {
  local PANEL="/usr/local/bin/snell-panel.sh"
  local PANEL_BAK="${CONFIG_DIR}/snell-panel.sh"
  local SRC=""

  mkdir -p "$CONFIG_DIR"

  # 1. 优先尝试定位当前脚本所在路径
  for candidate in "${BASH_SOURCE[0]:-}" "$0"; do
    if [[ -n "$candidate" && -f "$candidate" && -r "$candidate" ]]; then
      if grep -q "Snell (snell-server) 一键管理脚本" "$candidate" 2>/dev/null; then
        SRC="$candidate"
        break
      fi
    fi
  done

  if [[ -n "$SRC" ]]; then
    # FIX: 避免源文件与目标文件为同一物理文件时 cp 报错退出
    if [[ "$SRC" -ef "$PANEL" ]] || [[ "$SRC" == "$PANEL" ]]; then
      chmod +x "$PANEL"
    else
      cp -f "$SRC" "$PANEL"
      chmod +x "$PANEL"
    fi
    if [[ ! "$PANEL" -ef "$PANEL_BAK" ]]; then
      cp -f "$PANEL" "$PANEL_BAK" 2>/dev/null || true
    fi
    print_ok "面板脚本已成功保存"
  elif [[ -n "${SCRIPT_URL:-}" ]]; then
    print_info "尝试从远程 URL 下载脚本保存面板..."
    if curl -sSL --connect-timeout 10 -o "$PANEL" "$SCRIPT_URL" 2>/dev/null || wget -q -O "$PANEL" "$SCRIPT_URL" 2>/dev/null; then
      chmod +x "$PANEL"
      if [[ ! "$PANEL" -ef "$PANEL_BAK" ]]; then
        cp -f "$PANEL" "$PANEL_BAK" 2>/dev/null || true
      fi
      print_ok "已从远程下载并保存面板脚本"
    fi
  fi

  # 2. 补全互备路径
  if [[ ! -s "$PANEL" && -s "$PANEL_BAK" ]]; then
    if [[ ! "$PANEL_BAK" -ef "$PANEL" ]]; then
      cp -f "$PANEL_BAK" "$PANEL"
      chmod +x "$PANEL"
    fi
  elif [[ -s "$PANEL" && ! -s "$PANEL_BAK" ]]; then
    if [[ ! "$PANEL" -ef "$PANEL_BAK" ]]; then
      cp -f "$PANEL" "$PANEL_BAK"
    fi
  fi

  if [[ ! -s "$PANEL" ]]; then
    print_warn "未能自动保留面板脚本文件。"
    print_warn "提示：通过管道 (curl | bash) 运行脚本时，建议先下载脚本文件到本地，例如："
    print_warn "      curl -o snell.sh <脚本URL> && chmod +x snell.sh && ./snell.sh"
  fi

  # 3. 创建快捷指令 a
  cat > /usr/local/bin/a <<'EOF'
#!/bin/bash
for path in /usr/local/bin/snell-panel.sh /etc/snell/snell-panel.sh; do
  if [[ -f "$path" && -s "$path" ]]; then
    exec bash "$path" "$@"
  fi
done
echo "未找到 Snell 面板脚本，请把脚本保存到本地后再运行安装"
exit 1
EOF
  chmod +x /usr/local/bin/a

  # 4. 创建快捷指令 s（面板没保存时自动重新下载，保证运行过一次就能用）
  local S_ALREADY=false
  [[ -e /usr/local/bin/s ]] && S_ALREADY=true
  cat > /usr/local/bin/s <<EOF
#!/bin/bash
PANEL="/usr/local/bin/snell-panel.sh"
[[ -f "\$PANEL" && -s "\$PANEL" ]] || PANEL="/etc/snell/snell-panel.sh"
if [[ ! -f "\$PANEL" || ! -s "\$PANEL" ]]; then
  echo "正在获取 Snell 面板脚本..."
  if curl -fsSL --connect-timeout 10 -o /usr/local/bin/snell-panel.sh "${SCRIPT_URL}" 2>/dev/null || wget -q -O /usr/local/bin/snell-panel.sh "${SCRIPT_URL}" 2>/dev/null; then
    chmod +x /usr/local/bin/snell-panel.sh
    cp -f /usr/local/bin/snell-panel.sh /etc/snell/snell-panel.sh 2>/dev/null || true
    PANEL="/usr/local/bin/snell-panel.sh"
  else
    echo "获取失败，请检查网络后重试"
    exit 1
  fi
fi
exec bash "\$PANEL" "\$@"
EOF
  chmod +x /usr/local/bin/s
  if [[ "$S_ALREADY" != true ]]; then
    print_ok "已创建快捷命令 s：以后直接输入 s 即可打开面板"
  fi

  # 5. 创建快捷指令 snell
  cat > /usr/local/bin/snell <<'EOF'
#!/bin/bash
PANEL="/usr/local/bin/snell-panel.sh"
[[ -f "$PANEL" && -s "$PANEL" ]] || PANEL="/etc/snell/snell-panel.sh"

case "${1:-}" in
  --cleanup)
    # 保留 snell-server.bak（二进制回滚文件），只清临时残留
    find /usr/local/bin -maxdepth 1 -name 'snell-server.tmp.*' -mtime +1 -delete 2>/dev/null || true
    find /etc/snell -maxdepth 1 -name '*.tmp' -mtime +1 -delete 2>/dev/null || true
    rm -rf /tmp/snell-dl.* /tmp/snell.zip 2>/dev/null || true
    apt-get clean >/dev/null 2>&1 || true
    ;;
  *)
    if [[ -f "$PANEL" && -s "$PANEL" ]]; then
      exec bash "$PANEL" "$@"
    else
      echo "Snell 快捷命令"
      echo "  snell --cleanup      清理旧备份"
    fi
    ;;
esac
EOF
  chmod +x /usr/local/bin/snell
}

# 给已安装的老服务补上日志级别限制（新安装的服务已自带 --loglevel warning）
ensure_service_loglevel() {
  [[ -f "$SNELL_SERVICE_FILE" ]] || return 0
  grep -q -- '--loglevel' "$SNELL_SERVICE_FILE" 2>/dev/null && return 0

  print_info "为 snell.service 增加 --loglevel warning（减少日志写入）..."
  cp -f "$SNELL_SERVICE_FILE" "${SNELL_SERVICE_FILE}.loglevel.bak" 2>/dev/null || true
  sed -i 's|^ExecStart=.*$|& --loglevel warning|' "$SNELL_SERVICE_FILE"
  systemctl daemon-reload >/dev/null 2>&1 || true

  if is_active; then
    systemctl restart snell >/dev/null 2>&1 || true
    sleep 1
    if ! is_active; then
      print_warn "加上日志参数后启动失败，已回滚服务配置"
      mv -f "${SNELL_SERVICE_FILE}.loglevel.bak" "$SNELL_SERVICE_FILE" 2>/dev/null || true
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl restart snell >/dev/null 2>&1 || true
      return 0
    fi
  fi

  rm -f "${SNELL_SERVICE_FILE}.loglevel.bak"
  print_ok "snell 日志级别已限制为 warning"
}

# ==================== 核心功能：安装 ====================
# 把内核参数写进 /etc/sysctl.d/99-snell-network.conf
#
# 为什么不用 /etc/sysctl.conf：
# Debian 13 (trixie) 起，systemd 只读 /usr/lib/sysctl.d、/etc/sysctl.d、/run/sysctl.d，
# procps 也不再提供 /etc/sysctl.conf，原来的兼容软链 /etc/sysctl.d/99-sysctl.conf 已被删除。
# 所以写 /etc/sysctl.conf 在 Debian 13 上安装当时有效（脚本手动执行了 sysctl --system），
# 一重启就失效 —— BBR 掉回 cubic 就是这个原因。详细见 Debian #1110184 / #1077184。
write_sysctl_dropin() {
  mkdir -p /etc/sysctl.d

  # 迁移旧版脚本写进 /etc/sysctl.conf 的参数，同时清理上一版留下的 99-bbr.conf
  # 只删脚本自己管的三行，其余内容原样保留
  if [[ ! -f "$SYSCTL_MIGRATED_FLAG" ]]; then
    if [[ -f /etc/sysctl.conf ]]; then
      if grep -qE '^[[:space:]]*(net\.core\.default_qdisc|net\.ipv4\.tcp_congestion_control|net\.ipv4\.tcp_fastopen)[[:space:]]*=' /etc/sysctl.conf 2>/dev/null; then
        cp -a /etc/sysctl.conf "${CONFIG_DIR}/sysctl.conf.bak" 2>/dev/null || true
        sed -i -E '/^[[:space:]]*(net\.core\.default_qdisc|net\.ipv4\.tcp_congestion_control|net\.ipv4\.tcp_fastopen)[[:space:]]*=/d' /etc/sysctl.conf 2>/dev/null || true
      fi
    fi
    rm -f "$LEGACY_SYSCTL_FILE" 2>/dev/null || true
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    : > "$SYSCTL_MIGRATED_FLAG" 2>/dev/null || true
  fi

  cat > "$SYSCTL_FILE" <<'EOF'
# 由 Snell 一键脚本写入：BBR + fq + TCP Fast Open
# 只写 /etc/sysctl.d/ 下（systemd-sysctl 会读取），不要改回 /etc/sysctl.conf
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
EOF
  chmod 644 "$SYSCTL_FILE" 2>/dev/null || true

  # 尽早加载 bbr 模块，避免开机时模块还没加载导致参数写入失败
  if ! lsmod 2>/dev/null | grep -q '^tcp_bbr'; then
    modprobe tcp_bbr >/dev/null 2>&1 || true
  fi
  if [[ -d /etc/modules-load.d ]]; then
    if ! grep -qs '^tcp_bbr$' /etc/modules-load.d/snell-bbr.conf 2>/dev/null; then
      printf '%s\n' 'tcp_bbr' > /etc/modules-load.d/snell-bbr.conf 2>/dev/null || true
    fi
  fi
}

# 真实应用并回读校验，不靠“命令没报错”来判断成功
apply_sysctl_now() {
  sysctl --system >/dev/null 2>&1 || true
  sysctl -p "$SYSCTL_FILE" >/dev/null 2>&1 || true

  local cc qdisc tfo
  cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "")
  qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "")
  tfo=$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo "")

  if [[ "$cc" == "bbr" ]]; then
    print_ok "BBR 已生效 (default_qdisc=${qdisc:-未知}, tcp_fastopen=${tfo:-未知})"
  else
    print_warn "BBR 未生效（当前拥塞控制算法: ${cc:-未知}）"
    if [[ "$cc" == "cubic" ]] && ! modinfo tcp_bbr >/dev/null 2>&1; then
      print_warn "当前内核没有 tcp_bbr 模块，多数 VPS 的 Debian 内核都自带；若确实没有请更换内核"
    fi
    print_warn "排查: sysctl -p $SYSCTL_FILE"
  fi
}

# 开机自愈服务：内核参数 + 时区
# 只靠 /etc/sysctl.d 还不够稳：部分 VPS 的 DHCP 客户端、cloud-init 或面板脚本
# 会在启动后期把 BBR / qdisc / DNS 改回去，所以在启动末期再强制写一次
setup_boot_persist() {
  cat > "$NET_TUNE_SCRIPT" <<'EOF'
#!/bin/bash
# 由 Snell 一键脚本安装：开机末期重新强制生效内核网络参数与时区
SYSCTL_FILE="/etc/sysctl.d/99-snell-network.conf"

modprobe tcp_bbr >/dev/null 2>&1 || true
sysctl --system >/dev/null 2>&1 || true
[ -f "$SYSCTL_FILE" ] && sysctl -p "$SYSCTL_FILE" >/dev/null 2>&1

# 时区兜底：/etc/localtime 被改掉时重新指向上海
if [ -f /usr/share/zoneinfo/Asia/Shanghai ]; then
  if [ "$(readlink -f /etc/localtime 2>/dev/null)" != "/usr/share/zoneinfo/Asia/Shanghai" ]; then
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
  fi
fi

# 时间同步服务被停掉/禁用时重新启用（系统可能用 chrony 而不是 systemd-timesyncd）
if command -v systemctl >/dev/null 2>&1; then
  for s in systemd-timesyncd chrony chronyd ntp ntpd openntpd; do
    systemctl list-unit-files "$s.service" >/dev/null 2>&1 || continue
    systemctl is-enabled "$s" >/dev/null 2>&1 || systemctl enable "$s" >/dev/null 2>&1
    systemctl is-active "$s" >/dev/null 2>&1 || systemctl start "$s" >/dev/null 2>&1
    break
  done
fi

exit 0
EOF
  chmod +x "$NET_TUNE_SCRIPT" 2>/dev/null || true

  cat > "$NET_TUNE_UNIT_FILE" <<EOF
[Unit]
Description=Snell network tuning (re-apply sysctl/BBR/timezone after boot)
Documentation=file:${SYSCTL_FILE}
After=network-online.target
Wants=network-online.target
ConditionPathExists=${SYSCTL_FILE}

[Service]
Type=oneshot
ExecStart=${NET_TUNE_SCRIPT}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  chmod 644 "$NET_TUNE_UNIT_FILE" 2>/dev/null || true
}

# 静态 /etc/resolv.conf 往往会被 DHCP 客户端 / cloud-init / VPS 面板在重启后改回去，
# 所以让 systemd 在启动末期检查一次：缺少我们的 nameserver 就重写
setup_dns_persist() {
  cat > "$DNS_SCRIPT" <<'EOF'
#!/bin/bash
# 由 Snell 一键脚本安装：保证重启后 /etc/resolv.conf 仍是静态 DNS
NS4="1.1.1.1 8.8.8.8"
NS6="2606:4700:4700::1111 2001:4860:4860::8888"

need=0
for ns in $NS4; do
  grep -qE "^[[:space:]]*nameserver[[:space:]]+$ns([[:space:]]|$)" /etc/resolv.conf 2>/dev/null || need=1
done
if [ "$need" -eq 0 ] && [ -s /etc/resolv.conf ]; then
  exit 0
fi

chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
rm -f /etc/resolv.conf
{
  for ns in $NS4; do printf 'nameserver %s\n' "$ns"; done
  for ns in $NS6; do printf 'nameserver %s\n' "$ns"; done
} > /etc/resolv.conf
chmod 644 /etc/resolv.conf 2>/dev/null || true
exit 0
EOF
  chmod +x "$DNS_SCRIPT" 2>/dev/null || true

  cat > "$DNS_UNIT_FILE" <<EOF
[Unit]
Description=Snell static DNS (keep /etc/resolv.conf after reboot)
After=network-online.target snell-net-tune.service
Wants=network-online.target snell-net-tune.service

[Service]
Type=oneshot
ExecStart=${DNS_SCRIPT}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  chmod 644 "$DNS_UNIT_FILE" 2>/dev/null || true
}

enable_boot_persist() {
  [[ -d /run/systemd/system ]] || return 0
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable "$NET_TUNE_UNIT_NAME" >/dev/null 2>&1 || true
  systemctl enable "$DNS_UNIT_NAME" >/dev/null 2>&1 || true
}

# ==================== 核心功能：安装 ====================
apply_network_optimization() {
  mkdir -p "$CONFIG_DIR"
  write_sysctl_dropin
  setup_boot_persist
  enable_boot_persist
  apply_sysctl_now

  # 老安装的服务可能没有 LimitNOFILE，补上（原来只会改已存在的行）
  if [[ -f "$SNELL_SERVICE_FILE" ]]; then
    if grep -q '^LimitNOFILE=' "$SNELL_SERVICE_FILE"; then
      sed -i "s/^LimitNOFILE=.*/LimitNOFILE=${NET_NOFILE_LIMIT}/" "$SNELL_SERVICE_FILE"
    else
      sed -i "/^\[Service\]/a LimitNOFILE=${NET_NOFILE_LIMIT}" "$SNELL_SERVICE_FILE"
    fi
    systemctl daemon-reload >/dev/null 2>&1 || true
    if is_active; then
      systemctl restart snell >/dev/null 2>&1 || true
      sleep 1
      if is_active; then
        print_ok "服务已重启，新的文件描述符上限已生效"
      else
        print_warn "服务重启失败，请检查: journalctl -u snell -n 20"
      fi
    fi
  fi

  print_ok "网络优化已应用（内核参数写入 ${SYSCTL_FILE}，开机自动重申）"
}

# 启用系统里实际存在的时间同步守护进程
# Debian 13 精简 cloud 镜像不带 systemd-timesyncd，必须回退到 chrony，
# 否则会出现 "NTP service: n/a / System clock synchronized: no"
enable_time_sync() {
  local svc="" have=0
  for s in systemd-timesyncd chrony chronyd ntp ntpd openntpd; do
    systemctl list-unit-files "$s.service" >/dev/null 2>&1 || continue
    have=1
    if [[ -z "$svc" ]]; then
      svc="$s"
      systemctl enable --now "$s" >/dev/null 2>&1 || true
    else
      # 系统里装了多个时间同步服务会互相打架，多余的停掉，只留第一个可用的
      systemctl disable --now "$s" >/dev/null 2>&1 || true
    fi
  done

  if [[ "$have" -eq 0 ]]; then
    print_warn "未找到可用时间同步服务（系统不带 systemd-timesyncd/chrony）"
    if command -v apt-get >/dev/null 2>&1; then
      print_info "尝试安装 chrony..."
      if apt-get install -y -qq chrony >/dev/null 2>&1 || { apt-get update -qq >/dev/null 2>&1 && apt-get install -y -qq chrony >/dev/null 2>&1; }; then
        systemctl enable --now chrony >/dev/null 2>&1 || true
        svc="chrony"
      fi
    fi
  fi

  [[ -n "$svc" ]] && echo "$svc"
  return 0
}

# 时区 + 时间同步（重启后同样保持）
setup_timezone() {
  print_info "设置时区为 ${TZ_NAME} 并启用时间同步..."
  if command -v timedatectl >/dev/null 2>&1; then
    if ! timedatectl set-timezone "$TZ_NAME" 2>/dev/null; then
      ln -sf "/usr/share/zoneinfo/${TZ_NAME}" /etc/localtime 2>/dev/null || true
    fi
  else
    ln -sf "/usr/share/zoneinfo/${TZ_NAME}" /etc/localtime 2>/dev/null || true
  fi

  if command -v timedatectl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    timedatectl set-ntp true >/dev/null 2>&1 || true
  fi

  local TSVC
  TSVC=$(enable_time_sync)
  if [[ -n "$TSVC" ]]; then
    print_ok "时间同步服务: ${TSVC}"
  fi

  local now_tz
  now_tz=$(timedatectl show -p Timezone --value 2>/dev/null || echo "")
  if [[ -n "$now_tz" && "$now_tz" != "$TZ_NAME" ]]; then
    print_warn "时区未确认生效（当前: ${now_tz}），重启后由 ${NET_TUNE_UNIT_NAME} 再纠正"
  else
    print_ok "时区设置 完成"
  fi
}

# 静态 DNS + 阻止 systemd-resolved / resolvconf 重新接管
setup_dns() {
  print_info "配置静态 DNS（1.1.1.1 / 8.8.8.8）..."

  systemctl disable systemd-resolved --now >/dev/null 2>&1 || true
  systemctl mask systemd-resolved >/dev/null 2>&1 || true
  systemctl disable resolvconf --now >/dev/null 2>&1 || true
  systemctl mask resolvconf >/dev/null 2>&1 || true

  # 可能是软链、也可能被加了不可变属性，先都清掉
  chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
  rm -f /etc/resolv.conf

  if [[ "$(get_egress_stack)" == "v6only" ]]; then
    {
      for ns in $REQUIRED_NS_V6; do echo "nameserver ${ns}"; done
      for ns in $REQUIRED_NS_V4; do echo "nameserver ${ns}"; done
    } > /etc/resolv.conf
  else
    {
      for ns in $REQUIRED_NS_V4; do echo "nameserver ${ns}"; done
      for ns in $REQUIRED_NS_V6; do echo "nameserver ${ns}"; done
    } > /etc/resolv.conf
  fi
  chmod 644 /etc/resolv.conf 2>/dev/null || true

  setup_dns_persist
  enable_boot_persist
  print_ok "DNS 已写入 /etc/resolv.conf，并已安装开机自愈服务（${DNS_UNIT_NAME}）"
}

# 安装过程中的任何失败退出，都把系统设置再兜一次，避免留下半成品
# 两个自愈脚本都不在（未走过新版安装）时直接返回，绝不动系统文件
enforce_critical_settings() {
  [[ -f "$SYSCTL_FILE" ]] || return 0
  [[ -f "$DNS_SCRIPT" ]] || return 0
  sysctl --system >/dev/null 2>&1 || true
  sysctl -p "$SYSCTL_FILE" >/dev/null 2>&1 || true
  bash "$DNS_SCRIPT" >/dev/null 2>&1 || true
  enable_boot_persist
  return 0
}

# ==================== Swap 自动调整 ====================
setup_swap() {
  # 测试时可覆盖路径
  local MEMINFO="${SWAP_MEMINFO:-/proc/meminfo}"
  local SWAPS_FILE="${SWAP_SWAPS_FILE:-/proc/swaps}"
  local FSTAB="${SWAP_FSTAB:-/etc/fstab}"
  local SWAP_FILE="${SWAP_FILE:-/swapfile}"
  local SWAP_OFF_SERVICE="${SWAP_OFF_SERVICE:-/etc/systemd/system/disable-swap.service}"
  local RAM_MB SWAP_KB

  RAM_MB=$(awk '/^MemTotal:/{printf "%d", $2/1024}' "$MEMINFO" 2>/dev/null || echo 0)
  SWAP_KB=$(awk 'NR>1{s+=$3}END{print s+0}' "$SWAPS_FILE" 2>/dev/null || echo 0)

  if [[ -z "$RAM_MB" || "$RAM_MB" -eq 0 ]]; then
    print_warn "无法获取内存大小，跳过 Swap 配置"
    return 0
  fi

  # 1G 内存的 VPS 实际可用通常为 900-997M，按 900M 视为 1G 档
  local BIG_RAM_THRESHOLD_MB=900
  if [[ "$RAM_MB" -lt "$BIG_RAM_THRESHOLD_MB" ]]; then
    # 内存不足 1G 档：确保有至少 512M swap
    # 移除“开机强制关闭 swap”的服务，避免把我们创建的 swap 在重启后关掉
    if [[ -f "$SWAP_OFF_SERVICE" ]]; then
      systemctl disable disable-swap.service >/dev/null 2>&1 || true
      rm -f "$SWAP_OFF_SERVICE"
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    if [[ "$SWAP_KB" -ge 524288 ]]; then
      print_ok "内存 ${RAM_MB}M，已有 $(awk 'BEGIN{printf "%.0f", '"$SWAP_KB"'/1024}')M Swap，无需新增"
      return 0
    fi

    if [[ -f "$SWAP_FILE" ]]; then
      local CUR_MB
      CUR_MB=$(du -m "$SWAP_FILE" 2>/dev/null | awk '{print $1+0}' || echo 0)
      if [[ "$CUR_MB" -ge 512 ]]; then
        chmod 600 "$SWAP_FILE"
        grep -qs "^${SWAP_FILE}[[:space:]]" "$FSTAB" || echo "${SWAP_FILE} none swap sw 0 0" >> "$FSTAB"
        swapon "$SWAP_FILE" >/dev/null 2>&1 || true
        print_ok "内存不足 1G，已启用现有 ${SWAP_FILE} (${CUR_MB}M)"
        return 0
      fi
      # 已有 swapfile 但小于 512M，删掉重建
      swapoff "$SWAP_FILE" >/dev/null 2>&1 || true
      rm -f "$SWAP_FILE"
    fi

    print_info "内存不足 1G (${RAM_MB}M)，创建 512M Swap..."
    if command -v fallocate >/dev/null 2>&1; then
      fallocate -l 512M "$SWAP_FILE" 2>/dev/null || dd if=/dev/zero of="$SWAP_FILE" bs=1M count=512 2>/dev/null
    else
      dd if=/dev/zero of="$SWAP_FILE" bs=1M count=512 2>/dev/null
    fi
    chmod 600 "$SWAP_FILE"
    mkswap "$SWAP_FILE" >/dev/null 2>&1
    swapon "$SWAP_FILE" >/dev/null 2>&1
    grep -qs "^${SWAP_FILE}[[:space:]]" "$FSTAB" || echo "${SWAP_FILE} none swap sw 0 0" >> "$FSTAB"
    print_ok "Swap 已创建并启用 (512M)"
  else
    # 内存充足：关闭全部 swap（含系统自带），并清理 fstab 与脚本创建的 swapfile
    if [[ "$SWAP_KB" -gt 0 ]]; then
      print_info "内存充足 (${RAM_MB}M)，关闭全部 Swap..."
      swapoff -a >/dev/null 2>&1 || true
    fi
    # 移除 fstab 中所有 swap 条目（含系统自带），防止重启后恢复
    # 注意：不能用 grep -v，会弄坏无结尾换行的最后一行；用 awk 重写更稳
    if [[ -f "$FSTAB" ]]; then
      awk 'NF>=3 && $3=="swap" { next } { print }' "$FSTAB" > "${FSTAB}.snelltmp" && mv -f "${FSTAB}.snelltmp" "$FSTAB"
      chmod 644 "$FSTAB" 2>/dev/null || true
    fi
    # 删除脚本自己创建的 swapfile
    if [[ -f "$SWAP_FILE" ]]; then
      swapoff "$SWAP_FILE" >/dev/null 2>&1 || true
      rm -f "$SWAP_FILE"
    fi
    # 安装开机强制关闭 swap 的服务：防止 fstab 之外的机制在重启后重新启用 swap
    cat > "$SWAP_OFF_SERVICE" <<'EOF'
[Unit]
Description=Disable Swap (managed by one-click proxy script)
DefaultDependencies=no
After=local-fs.target swap.target
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in 1 2 3; do swapoff -a >/dev/null 2>&1; sleep 2; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable disable-swap.service >/dev/null 2>&1 || true
    if [[ "$SWAP_KB" -gt 0 ]]; then
      print_ok "全部 Swap 已关闭，fstab 中的 swap 条目已移除"
    else
      print_ok "内存充足 (${RAM_MB}M)，Swap 未启用，已同步清理 fstab 中的 swap 条目"
    fi
  fi
}

install_snell() {
  clear
  hr
  print_info "开始安装 Snell (snell-server)"
  hr

  # 如果已安装，先停止服务；旧二进制等新版下载成功后再覆盖，避免下载失败时服务不可用
  if is_installed; then
    print_info "检测到已有安装，先停止服务..."
    systemctl stop snell >/dev/null 2>&1 || true
    systemctl disable snell >/dev/null 2>&1 || true
    rm -f "${SNELL_BIN}.bak"
    rm -f "${SNELL_BIN}.tmp."*
    rm -f "${CONFIG_DIR}"/*.tmp 2>/dev/null || true
    sleep 1
    print_ok "旧服务已停止"
  fi

  # 依赖（自动安装 curl/unzip 等；失败会显示真实原因并重试一次）
  install_deps
  print_ok "必要依赖检查通过"

  local TZ_NOW
  TZ_NOW=$(timedatectl show -p Timezone --value 2>/dev/null || echo "")
  [[ "$TZ_NOW" != "$TZ_NAME" ]] && print_info "当前时区: ${TZ_NOW:-未知}"

  # 网络探测（决定监听栈 / DNS / 出站策略）
  print_info "检测服务器网络与出口 IP..."
  check_system_ip
  [[ "$IP_STACK" == "unknown" ]] && { print_err "无法获取服务器 IP，请检查网络"; exit 1; }
  mkdir -p "$CONFIG_DIR"
  echo "$IP_STACK" > "$NET_FILE"
  if [[ "$IP_STACK" == "dual" || "$IP_STACK" == "v4only" ]]; then
    grep -q "precedence ::ffff:0:0/96 100" /etc/gai.conf 2>/dev/null || echo "precedence ::ffff:0:0/96 100" >> /etc/gai.conf
  fi

  # 架构
  ARCH=$(get_arch)
  print_info "检测到系统架构: ${BGreen}${ARCH}${Font}"

  # 交互输入
  echo ""
  if [[ "$IP_STACK" == "dual" ]]; then
    echo -e "当前服务器 IPv4: ${BGreen}${IPV4}${Font}"
    echo -e "当前服务器 IPv6: ${BGreen}${IPV6}${Font}"
    echo -e "栈类型: ${BGreen}双栈 (IPv6 入站 + 仅 IPv4 出站)${Font}"
  elif [[ "$IP_STACK" == "v4only" ]]; then
    echo -e "当前服务器 IPv4: ${BGreen}${IPV4}${Font}"
    echo -e "栈类型: ${BGreen}仅 IPv4${Font}"
  elif [[ "$IP_STACK" == "v6only" ]]; then
    echo -e "当前服务器 IPv6: ${BGreen}${IPV6}${Font}"
    echo -e "栈类型: ${BGreen}仅 IPv6 入站（出站按服务器实际网络）${Font}"
  fi
  echo -e "以下配置直接回车将使用默认值"
  echo ""

  local input_port
  read -rp "请输入 Snell 端口 [默认: 26216]: " input_port
  local PORT=${input_port:-26216}
  while ! valid_port "$PORT" || is_port_used "$PORT"; do
    print_warn "端口无效或已被占用"
    read -rp "请输入 Snell 端口 [默认: 26216]: " input_port
    PORT=${input_port:-26216}
  done

  local DEF_PASS
  DEF_PASS=$(gen_password)
  local PASS
  PASS=$(read_psk_interactive "" "$DEF_PASS")

  local MODE
  MODE=$(read_mode_interactive)

  # 下载 snell-server（先确保二进制可用，再做任何系统级改动）
  print_info "获取 snell-server ${SNELL_VERSION}..."
  local VER
  VER=$(download_snell "$SNELL_BIN") || VER=""
  if [[ -z "$VER" ]]; then
    print_err "下载 snell-server 失败，未改动任何系统设置，可直接重试"
    # 重装场景：旧二进制还在，把之前停掉的服务拉起来，避免节点直接失联
    if [[ -x "$SNELL_BIN" && -f "$SNELL_SERVICE_FILE" ]]; then
      systemctl start snell >/dev/null 2>&1 || true
      print_info "已尝试恢复原有 snell 服务"
    fi
    exit 1
  fi
  print_ok "snell-server 已安装: ${VER}"

  # 系统级改动统一收敛到这里：时区 / 内核参数 / DNS / Swap
  # 用子 shell 执行，任何一步失败都会触发 EXIT trap 做一次兜底重申
  IN_INSTALL=true
  trap 'install_guard_exit' EXIT

  (
    # 时区 + 时间同步
    setup_timezone

    # 内核网络优化（BBR / fq / TFO）+ 开机自愈服务
    # 同时装上静态 DNS 的开机自愈服务（顺序不能反，DNS 不是 network-online 的前置）
    print_info "优化网络配置..."
    apply_network_optimization
    setup_dns

    # Swap 自动调整
    setup_swap

    # 根据栈类型生成配置
    mkdir -p "$CONFIG_DIR"
    echo "$IP_STACK" > "$STACK_FILE"
    echo "$MODE" > "$MODE_FILE"
    write_snell_conf "$PORT" "$PASS" "$IP_STACK" "$MODE"

    # systemd（搭建方式参考 GetSomeCats 文档：nobody 运行 + CAP_NET_BIND_SERVICE）
    local SVC_USER="nobody" SVC_GROUP="nogroup"
    if ! getent group nogroup >/dev/null 2>&1; then
      SVC_GROUP="nobody"
    fi
    chown "root:${SVC_GROUP}" "$CONF_FILE" >/dev/null 2>&1 || chmod 644 "$CONF_FILE"
    chmod 640 "$CONF_FILE" >/dev/null 2>&1 || true

    cat > "$SNELL_SERVICE_FILE" <<EOF
[Unit]
Description=Snell Server (snell-server)
After=network.target

[Service]
Type=simple
User=${SVC_USER}
Group=${SVC_GROUP}
LimitNOFILE=${NET_NOFILE_LIMIT:-1048576}
ExecStart=${SNELL_BIN} -c ${CONF_FILE} --loglevel warning
Restart=on-failure
RestartSec=3s
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=snell-server

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable snell >/dev/null 2>&1 || true
    systemctl restart snell >/dev/null 2>&1 || true
    sleep 2

    for _ in 1 2 3; do
      systemctl is-active --quiet snell && break
      sleep 1
    done

    if ! systemctl is-active --quiet snell; then
      print_err "Snell 启动失败"
      journalctl -u snell -n 20 --no-pager
      if [[ -x "${SNELL_BIN}.bak" ]]; then
        print_warn "检测到旧版本备份，正在回滚二进制..."
        mv -f "${SNELL_BIN}.bak" "$SNELL_BIN"
        systemctl restart snell >/dev/null 2>&1 || true
        sleep 2
        if systemctl is-active --quiet snell; then
          print_ok "已回滚到旧版本，服务恢复正常；请检查新版本是否与当前系统兼容"
        else
          print_err "回滚后仍未启动，请手动排查: journalctl -u snell -n 50"
        fi
      fi
      exit 1
    fi
    judge "服务启动"

    # 防火墙
    setup_ufw "$PORT"

    # 定时任务
    setup_cron

    # 快捷命令
    create_shortcut

    # 导出信息
    export_snell_info "$PORT" "$PASS" "$MODE"

    # 子 shell 自身收尾也清掉标记，避免它的 EXIT trap 重复兜底
    IN_INSTALL=false
  ) || {
    trap - EXIT
    IN_INSTALL=false
    print_err "安装过程中断，请根据上面提示处理后重试"
    # 已经下载好新二进制但服务没起来的情况，恢复一次旧服务更友好
    if [[ -x "${SNELL_BIN}.bak" && -f "$SNELL_SERVICE_FILE" ]]; then
      print_info "检测到旧版本备份，可在面板重试安装以自动回滚"
    fi
    exit 1
  }

  # 系统改动已经完成，撤掉兜底 trap
  trap - EXIT
  IN_INSTALL=false
  enable_boot_persist

  # 完成
  echo ""
  print_ok "Snell 部署完成"
  echo -e " ${BGreen}$(cat "$LIST_FILE")${Font}"
  echo ""
  print_info "重启后自动保持：BBR($(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '?')) / DNS / 时区($(timedatectl show -p Timezone --value 2>/dev/null || echo '?'))"
  echo ""

  pause
}

