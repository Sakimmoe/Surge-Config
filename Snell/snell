# ==================== 一键体检 ====================
health_check() {
  clear
  hr
  print_info "Snell 一键体检"
  hr
  echo "=== Snell 服务 ==="
  echo "开机自启: $(systemctl is-enabled snell 2>/dev/null || echo '未启用')"
  echo "运行状态: $(systemctl is-active snell 2>/dev/null || echo '未运行')"
  systemctl status snell --no-pager -n 3 2>/dev/null | sed -n '1,4p' || true
  echo "=== 监听端口 ==="
  ss -tlnp 2>/dev/null | grep -i snell || echo "未发现 snell 监听端口"
  echo "=== BBR / 网络优化（重启后是否还在）==="
  printf '拥塞控制算法: %s\n' "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '读取失败')"
  printf '队列算法    : %s\n' "$(sysctl -n net.core.default_qdisc 2>/dev/null || echo '读取失败')"
  printf 'TCP FastOpen: %s\n' "$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo '读取失败')"
  echo "配置文件: ${SYSCTL_FILE}"
  if [[ -f "$SYSCTL_FILE" ]]; then
    echo "  [存在] 内容: $(tr '\n' ';' < "$SYSCTL_FILE" 2>/dev/null || echo '读取失败')"
  else
    echo "  [缺失] 重启后会失效，请执行菜单 9 重新应用"
  fi
  echo "开机自愈服务: $(systemctl is-enabled "$NET_TUNE_UNIT_NAME" 2>/dev/null || echo '未启用') / $(systemctl is-active "$NET_TUNE_UNIT_NAME" 2>/dev/null || echo '未运行')"
  if [[ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '')" != "bbr" ]]; then
    echo "  [注意] BBR 未生效，执行菜单 9 或 sysctl -p ${SYSCTL_FILE} 排查"
  fi
  echo "旧文件 /etc/sysctl.conf（Debian 13 已不读取，仅作参考）:"
  grep -nE 'tcp_congestion_control|default_qdisc|tcp_fastopen' /etc/sysctl.conf 2>/dev/null || echo "  （无相关参数，正常）"
  echo "=== Swap ==="
  free -h
  echo "disable-swap 服务: $(systemctl is-enabled disable-swap 2>/dev/null || echo '未安装/未启用')"
  echo "=== DNS ==="
  cat /etc/resolv.conf
  echo "systemd-resolved: $(systemctl is-enabled systemd-resolved 2>/dev/null || echo '未启用')"
  echo "DNS 自愈服务: $(systemctl is-enabled "$DNS_UNIT_NAME" 2>/dev/null || echo '未启用')"
  printf '解析测试: %s\n' "$(getent hosts raw.githubusercontent.com 2>/dev/null | head -1 || echo '解析失败，请检查 /etc/resolv.conf 与 DNS 连通性')"
  echo "=== UFW ==="
  ufw status 2>/dev/null | head -10 || echo "UFW 未安装或不可用"
  echo "=== 时区 / 时间 ==="
  timedatectl 2>/dev/null | sed -n '1,6p' || date
  echo "NTP 同步: $(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo '未知')"
  local TS_FOUND=""
  for _ts in systemd-timesyncd chrony chronyd ntp ntpd openntpd; do
    if systemctl list-unit-files "${_ts}.service" >/dev/null 2>&1; then
      TS_FOUND="${_ts}.service enabled=$(systemctl is-enabled "${_ts}" 2>/dev/null || echo -) active=$(systemctl is-active "${_ts}" 2>/dev/null || echo -)"
      break
    fi
  done
  if [[ -n "$TS_FOUND" ]]; then
    echo "时间服务: ${TS_FOUND}"
  else
    echo "时间服务: 未安装（执行菜单 9 会自动安装 chrony）"
  fi
  echo "=== 定时清理 ==="
  echo "cron: $(systemctl is-enabled cron 2>/dev/null || echo '未启用')"
  echo "任务文件: $( [[ -f "$CRON_CLEAN" ]] && echo '存在' || echo '缺失（执行菜单 9 可重建）' )"
  echo "=== 快捷命令 ==="
  ls -l /usr/local/bin/s /usr/local/bin/snell 2>/dev/null || true
  hr
  pause
}

# ==================== 卸载 ====================
uninstall_snell() {
  clear
  hr
  if ! is_installed; then
    print_err "Snell 未安装"
    pause
    return
  fi

  local ans
  read -rp "确认卸载并删除所有配置？(y/N): " ans
  [[ ! "${ans:-N}" =~ ^[Yy]$ ]] && { print_info "已取消"; pause; return; }

  print_info "停止服务..."
  systemctl stop snell >/dev/null 2>&1 || true
  systemctl disable snell >/dev/null 2>&1 || true
  rm -f "$SNELL_SERVICE_FILE"
  systemctl daemon-reload >/dev/null 2>&1 || true

  print_info "清理文件..."
  rm -f "$SNELL_BIN" "${SNELL_BIN}.bak"
  rm -f /usr/local/bin/snell
  rm -f /usr/local/bin/a
  rm -f /usr/local/bin/s
  rm -f /usr/local/bin/snell-panel.sh
  rm -f "${CONFIG_DIR}/snell-panel.sh"
  rm -f "$CRON_CLEAN"
  rm -f /usr/local/bin/snell-cleanup.sh
  rm -rf "$CONFIG_DIR"

  # 系统级改动：默认保留（避免把别的程序依赖的 DNS / Swap 设置弄坏），提示用户可手动还原
  print_info "系统设置（BBR / 静态 DNS / 时区 / Swap）默认保留，且重启后仍生效。"
  print_info "如需一并还原："
  print_info "  systemctl disable --now ${NET_TUNE_UNIT_NAME} ${DNS_UNIT_NAME}"
  print_info "  rm -f ${NET_TUNE_UNIT_FILE} ${DNS_UNIT_FILE} ${NET_TUNE_SCRIPT} ${DNS_SCRIPT}"
  print_info "  rm -f ${SYSCTL_FILE} /etc/modules-load.d/snell-bbr.conf"
  print_info "  systemctl unmask systemd-resolved && systemctl enable --now systemd-resolved"
  print_info "  systemctl unmask resolvconf 2>/dev/null; systemctl disable --now disable-swap 2>/dev/null"

  print_ok "Snell 已彻底卸载"
  pause
}

