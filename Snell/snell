# ==================== 切换监听模式 / 协议模式 ====================
change_mode() {
  clear
  hr
  print_info "切换 Snell 监听模式 / 协议模式"
  hr

  if ! is_installed; then
    print_err "Snell 未安装"
    pause
    return
  fi

  echo " 1. 切换监听模式（IPv4 / 双栈 / IPv6）"
  echo " 2. 切换协议模式（default / unshaped / unsafe-raw）"
  local sub
  read -rp "请选择 [1-2]: " sub
  case "$sub" in
    1) change_listen_mode ;;
    2) change_protocol_mode ;;
    *) print_warn "无效选项"; pause ;;
  esac
}

change_listen_mode() {
  clear
  hr
  print_info "切换 Snell 监听模式"
  hr

  local CUR_STACK=$(cat "$STACK_FILE" 2>/dev/null || echo "unknown")
  local CUR_TEXT="双栈 (IPv6 入站 + 仅 IPv4 出站)"
  case "$CUR_STACK" in
    v4only) CUR_TEXT="仅 IPv4" ;;
  v6only) CUR_TEXT="仅 IPv6 入站（出站按服务器实际网络）" ;;
  esac

  echo -e "当前模式: ${BGreen}${CUR_TEXT}${Font}"
  echo " 1. 仅 IPv4"
  echo " 2. 双栈 (IPv6 入站 + 仅 IPv4 出站)"
  echo " 3. 仅 IPv6 入站（出站按服务器实际网络）"
  local input
  read -rp "请选择 [1-3]: " input
  local NEW_STACK=""
  case "$input" in
    1) NEW_STACK="v4only" ;;
    2) NEW_STACK="dual" ;;
    3) NEW_STACK="v6only" ;;
    *) print_warn "无效选项"; pause; return ;;
  esac

  [[ "$NEW_STACK" = "$CUR_STACK" ]] && { print_ok "模式未变更"; pause; return; }

  local PORT=$(get_conf_port)
  local PASS=$(get_conf_psk)
  local MODE=$(cat "$MODE_FILE" 2>/dev/null || echo "default")
  write_snell_conf "$PORT" "$PASS" "$NEW_STACK" "$MODE"
  echo "$NEW_STACK" > "$STACK_FILE"
  judge "配置更新"

  systemctl restart snell >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "监听模式已切换"
    export_snell_info "$PORT" "$PASS" "$MODE"
  else
    print_err "服务重启失败"
  fi
  pause
}

change_protocol_mode() {
  clear
  hr
  print_info "切换 Snell 协议模式（服务端与客户端必须一致）"
  hr

  local CUR_MODE=$(cat "$MODE_FILE" 2>/dev/null || echo "default")
  local CUR_TEXT="default（混淆 + AES）"
  case "$CUR_MODE" in
    unshaped)   CUR_TEXT="unshaped（仅 AES，约快 10%）" ;;
    unsafe-raw) CUR_TEXT="unsafe-raw（明文，仅限内网）" ;;
  esac

  echo -e "当前模式: ${BGreen}${CUR_TEXT}${Font}"
  echo " 1. default     混淆 + AES 加密（推荐）"
  echo " 2. unshaped    仅 AES 加密，无混淆，吞吐约快 10%"
  echo " 3. unsafe-raw  明文传输，仅限内网或已有安全隧道"
  local input
  read -rp "请选择 [1-3]: " input
  local NEW_MODE=""
  case "$input" in
    1) NEW_MODE="default" ;;
    2) NEW_MODE="unshaped" ;;
    3)
      NEW_MODE="unsafe-raw"
      print_warn "unsafe-raw 为明文模式，仅适合内网或已有安全隧道，请谨慎选择"
      ;;
    *) print_warn "无效选项"; pause; return ;;
  esac

  [[ "$NEW_MODE" = "$CUR_MODE" ]] && { print_ok "模式未变更"; pause; return; }

  local PORT=$(get_conf_port)
  local PASS=$(get_conf_psk)
  local STACK=$(cat "$STACK_FILE" 2>/dev/null || echo "dual")
  write_snell_conf "$PORT" "$PASS" "$STACK" "$NEW_MODE"
  echo "$NEW_MODE" > "$MODE_FILE"
  judge "配置更新"

  systemctl restart snell >/dev/null 2>&1 || true
  sleep 1
  if is_active; then
    print_ok "协议模式已切换"
    export_snell_info "$PORT" "$PASS" "$NEW_MODE"
  else
    print_err "服务重启失败"
  fi
  pause
}

